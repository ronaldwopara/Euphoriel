            <h2 class="text-[#1F4C35] text-3xl md:text-5xl lg:text-6xl font-semibold" style="font-family:'Cormorant Garamond', serif; font-weight:700;">Cleanse</h2>
        </div>

        <!-- Product Grid -->
        <div class="px-4 sm:px-6 md:px-20 lg:px-28 py-8 md:py-16">
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 md:gap-8 lg:gap-10">

