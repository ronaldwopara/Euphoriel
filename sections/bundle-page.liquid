                    <p class="bundle-price-display text-base md:text-lg font-bold text-[#1F4C35] h-[1.5rem] md:h-[1.75rem] mb-1" style="font-family:'DM Sans', sans-serif;">${{ bp_full.price | money_without_currency }}</p>
                    <div class="mb-1">
                        <p class="text-[10px] md:text-xs text-gray-500 mb-1 h-[1.75rem] md:h-[2rem]" style="font-family:'DM Sans', sans-serif;">Full Size (8.4oz | 250ml), Travel Size (3.4oz | 100ml)</p>
