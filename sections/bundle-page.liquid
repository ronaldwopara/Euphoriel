
{% comment %} ── Google Fonts (same as quiz-page) ── {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  @font-face {
    font-family: 'Cormorant Bundle';
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    src: url('https://fonts.gstatic.com/s/cormorantgaramond/v21/co3hmX5slCNuHLi8bLeY9MK7whWMhyjypVO7abI26QOD_v86eHjmeyOkkv20ULzqxhhXP9yI5uY2.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Instrument Sans Bundle';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('https://res.cloudinary.com/dyhflagbc/raw/upload/v1787317552/instrumentsans_n7.e4ad9032e203f9a0977786c356573ced65a7419a_xnghjk.woff2') format('woff2');
  }
  .bundle-page-wrap .bundle-product-title {
    font-family: 'Instrument Sans Bundle', sans-serif !important;
    -webkit-text-stroke: 0 !important;
  }
  #shopify-section-{{ section.id }} {
    scroll-behavior: smooth;
  }
  .bundle-page-wrap h1,
  .bundle-page-wrap h2,
  .bundle-page-wrap h3 {
    font-family: 'Cormorant Garamond', 'Cormorant Bundle', serif !important;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    font-synthesis: none;
    -webkit-text-stroke: 0.3px rgba(31, 76, 53, 0.3);
  }
  .bundle-page-wrap h1 {
    font-weight: 500 !important;
  }
  .bundle-page-wrap h2,
  .bundle-page-wrap h3 {
    font-weight: 700 !important;
  }
  /* Locks width/display explicitly — Tailwind's utility classes never set `width`
     on this button, so a theme-wide `button { width: 100% }` mobile rule (common
     in Shopify themes) would otherwise apply unopposed and blow up the sticky bar.
     Full-width is intentional below md (stacked footer); locked to auto at md+ (inline row). */
  #bundle-cta {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    flex: 0 0 auto !important;
  }
  @media screen and (min-width: 768px) {
    #bundle-cta {
      width: auto !important;
    }
  }
  /* Theme image/card rules must not restyle filled slots into white shadowed tiles. */
  .bundle-slot {
    background: rgba(197, 219, 195, 0.4) !important;
    border: 1px solid rgba(31, 76, 53, 0.15) !important;
    box-shadow: none !important;
    overflow: visible;
  }
  .bundle-slot img {
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: contain !important;
    object-position: center !important;
    padding: 6px;
    background: transparent !important;
    box-shadow: none !important;
    border: 0 !important;
    border-radius: 0 !important;
    filter: none !important;
  }
</style>

{% style %}
  #shopify-section-{{ section.id }} {
    margin: 0;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% comment %} Tailwind is used for all utility classes below. Skip this tag if the theme already loads Tailwind elsewhere on the page. {% endcomment %}
<script src="https://cdn.tailwindcss.com"></script>

<div class="bundle-page-wrap section-{{ section.id }}-padding bg-white pb-36 md:pb-24">

    <!-- Hero Section --><section class="relative w-full bg-[#F2EFE6] overflow-hidden">
        <div class="relative w-full max-w-[1240px] mx-auto flex flex-col items-start lg:flex-row lg:items-center gap-[24px] lg:gap-[6px] px-6 md:px-12 lg:px-6 py-10 md:py-14 lg:py-16" style="justify-content: center !important;">
            <div class="w-full max-w-[680px]" style="font-family:'DM Sans', sans-serif;">
                <h1 class="text-[#1F4C35] font-normal text-5xl md:text-7xl lg:text-8xl" style="font-family:'Cormorant Garamond', serif; line-height:1.02; letter-spacing:-0.02em;">
                    Build Your<br>Own Bundle
                </h1>
                <p class="mt-3 text-[#1F4C35] font-medium text-xl md:text-2xl lg:text-3xl" style="line-height:1.7;">
                    Choose 3+ products to<br>unlock <span class="font-bold">20% off</span>.
                </p>
            </div>

            <!-- Product Photo Card --><div class="relative w-full max-w-[357px] md:max-w-[459px] lg:max-w-none lg:w-[612px] flex-shrink-0">
                <!-- Soft cast shadow behind the card -->
                <div class="absolute left-1/2 -translate-x-1/2 bottom-0 w-[80%] h-10 md:h-14 bg-[#1F4C35]/25 blur-2xl rounded-full" aria-hidden="true"></div>

                <div class="relative aspect-square overflow-hidden rounded-xl ring-1 ring-[#1F4C35]/10 shadow-[0_25px_50px_-20px_rgba(31,76,53,0.35)]">
                    <img src="https://res.cloudinary.com/s1km9nr7/image/upload/v1785638583/euphoriel/3_Step_Glow_Routine_Products.avif" alt="" class="w-full h-full object-contain" style="filter: sepia(10%) saturate(118%) brightness(103%) contrast(101%);">

                    <!-- Vignette to soften the flat "sticker" edges -->
                    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(circle at 50% 45%, rgba(0,0,0,0) 55%, rgba(35,25,10,0.16) 100%);" aria-hidden="true"></div>

                    <!-- Warm blend layer to unify badge/photo color temperature -->
                    <div class="absolute inset-0 pointer-events-none mix-blend-multiply" style="background: linear-gradient(135deg, rgba(214,178,120,0.12), rgba(196,146,86,0.05));" aria-hidden="true"></div>
                </div>
            </div>
        </div>

        <!-- Soft seam into the step section below -->
        <div class="w-full h-8 md:h-12 bg-gradient-to-b from-[#F2EFE6] to-white" aria-hidden="true"></div>
    </section>

    <!-- ===================== STEP 1: CLEANSE ===================== -->
