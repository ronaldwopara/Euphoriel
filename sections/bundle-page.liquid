        <div class="w-full h-32 md:h-40 lg:h-[165px] flex flex-col items-center justify-center text-center bg-cover bg-center" style="background-image: url('https://res.cloudinary.com/s1km9nr7/image/upload/v1785636615/euphoriel/cleanse.png');">
