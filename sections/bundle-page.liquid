                {% assign bp_product = all_products['radiance-ritual-shower-oil'] %}
                {% assign bp_full = bp_product.variants[0] %}
                {% assign bp_travel = bp_product.variants[1] %}
                {% for v in bp_product.variants %}
                    {% if v.title contains 'Travel' or v.title contains 'Mini' %}{% assign bp_travel = v %}{% else %}{% assign bp_full = v %}{% endif %}
