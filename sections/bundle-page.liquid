<script>
    (function () {
        const BUNDLE_KEY  = 'euphorielBundle';
        const MAX_SLOTS   = 4;
        const DISCOUNT_AT = 2;

        function discountRate(count) {
            if (count >= 3) return 0.20;
            if (count >= 2) return 0.15;
            return 0;
        }

        function getBundle() {
            try { return JSON.parse(localStorage.getItem(BUNDLE_KEY)) || []; }
            catch (e) { return []; }
        }

        function saveBundle(items) {
            localStorage.setItem(BUNDLE_KEY, JSON.stringify(items));
        }

        function parsePrice(str) {
            const match = String(str || '').replace(/,/g, '').match(/[\d.]+/);
            return match ? parseFloat(match[0]) : 0;
        }

        function formatMoney(amount) {
            return '$' + Math.round(amount);
        }

        function slotPlaceholder(n) {
            const labels = { 2: 'Unlock<br>15% Off', 3: 'Unlock<br>20% Off' };
            const badge  = `<span class="absolute -top-1.5 -left-1.5 w-4 h-4 md:w-5 md:h-5 rounded-full bg-[#1F4C35] text-white text-[10px] font-bold flex items-center justify-center shadow-sm z-10">${n}</span>`;
            const label  = labels[n]
                ? `<span class="text-[#1F4C35] text-[10px] md:text-xs font-semibold leading-tight px-1">${labels[n]}</span>`
                : '';
            return badge + label;
        }

        function renderBundleBar() {
            const items = getBundle();

            for (let i = 0; i < MAX_SLOTS; i++) {
                const slot = document.getElementById('bundle-slot-' + (i + 1));
                if (!slot) continue;

                if (items[i]) {
                    slot.innerHTML = `
                        <span class="absolute -top-1.5 -left-1.5 w-4 h-4 md:w-5 md:h-5 rounded-full bg-[#1F4C35] text-white text-[10px] font-bold flex items-center justify-center shadow-sm z-10">${i + 1}</span>
                        <span class="bundle-remove absolute inset-1.5 rounded-md bg-black/0 group-hover:bg-black/50 flex items-center justify-center cursor-pointer transition-colors duration-200 z-10" data-index="${i}" aria-label="Remove ${items[i].name}">
                            <span class="text-white text-base md:text-lg font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-200">&times;</span>
                        </span>
                        <img src="${items[i].img}" alt="${items[i].name}" class="w-full h-full object-contain">
                        <span class="absolute -top-8 left-1/2 -translate-x-1/2 whitespace-nowrap bg-[#1F4C35] text-white text-[10px] md:text-xs px-2 py-1 rounded-md opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none z-20">${items[i].name}</span>
                    `;
                } else {
                    slot.innerHTML = slotPlaceholder(i + 1);
                }
            }

            document.querySelectorAll('.bundle-remove').forEach(btn => {
                btn.addEventListener('click', () => {
                    const idx = parseInt(btn.dataset.index, 10);
                    const items = getBundle();
                    items.splice(idx, 1);
                    saveBundle(items);
                    renderBundleBar();
                });
            });

            const cta = document.getElementById('bundle-cta');
            const remaining = DISCOUNT_AT - items.length;
            const ready = remaining <= 0;

            cta.style.letterSpacing = ready ? '0.13em' : '0.02em';
            cta.style.textTransform = ready ? 'uppercase' : 'none';

            if (items.length === 0) {
                cta.textContent = 'Add 2 & Unlock Savings';
            } else if (!ready) {
                cta.textContent = `Add ${remaining} & Save`;
            } else {
                const subtotal = items.reduce((sum, item) => sum + parsePrice(item.price), 0);
                const discounted = subtotal * (1 - discountRate(items.length));
                cta.innerHTML = `<span class="line-through opacity-70 mr-1">${formatMoney(subtotal)}</span> ${formatMoney(discounted)} — Add to Cart`;
            }
            cta.disabled = !ready;
            cta.classList.toggle('cursor-not-allowed', !ready);
        }

        window.addToBundle = function (item) {
            const items = getBundle();
            if (items.length >= MAX_SLOTS) return;
            items.push(item);
            saveBundle(items);
            renderBundleBar();
        };

        document.querySelectorAll('.add-to-bundle-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                window.addToBundle({
                    name:      btn.dataset.name,
                    img:       btn.dataset.img,
                    price:     btn.dataset.price,
                    variantId: btn.dataset.variantId,
                });
            });
        });

        // Full Size / Travel Size toggle — updates the card's Add to Bundle
        // button to point at whichever variant is currently selected.
        document.querySelectorAll('.size-toggle-group').forEach(group => {
            const card = group.closest('.flex.flex-col');
            const addBtn = card.querySelector('.add-to-bundle-btn');
            const priceDisplay = card.querySelector('.bundle-price-display');
            const productImg = card.querySelector('.bundle-product-img');
            const imgFull = group.dataset.imgFull;
            const imgTravel = group.dataset.imgTravel;
            
            group.querySelectorAll('.size-toggle-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const isTravel = btn.textContent.toLowerCase().includes('travel');
                    
                    group.querySelectorAll('.size-toggle-btn').forEach(b => {
                        b.classList.remove('bg-[#1F4C35]', 'text-white');
                        b.classList.add('bg-white', 'text-[#1F4C35]');
                        b.style.setProperty('border', '1px solid #1F4C35', 'important');
                    });
                    btn.classList.remove('bg-white', 'text-[#1F4C35]');
                    btn.classList.add('bg-[#1F4C35]', 'text-white');
                    btn.style.setProperty('border', '1px solid #1F4C35', 'important');

                    if (addBtn) {
                        addBtn.dataset.variantId = btn.dataset.variantId;
                        addBtn.dataset.price = btn.dataset.price;
                        // Update image URL for bundle slots
                        if (imgFull && imgTravel) {
                            addBtn.dataset.img = isTravel ? imgTravel : imgFull;
                        }
                    }
                    if (priceDisplay) {
                        priceDisplay.textContent = btn.dataset.price.replace(/\s*CAD$/, '');
                    }
                    // Swap product card image
                    if (productImg && imgFull && imgTravel) {
                        productImg.src = isTravel ? imgTravel : imgFull;
                    }
                });
            });
        });

        // Auto-add the quiz-matched product, e.g. /pages/about?view=build-your-bundle&face=balance
        const faceKey = new URLSearchParams(window.location.search).get('face');
        if (faceKey) {
            const matchBtn = document.querySelector('.add-to-bundle-btn[data-face-key="' + faceKey + '"]');
            if (matchBtn) {
                const items = getBundle();
                const alreadyAdded = items.some(i => i.name === matchBtn.dataset.name);
                if (!alreadyAdded) {
                    window.addToBundle({
                        name:      matchBtn.dataset.name,
                        img:       matchBtn.dataset.img,
                        price:     matchBtn.dataset.price,
                        variantId: matchBtn.dataset.variantId,
                    });
                }
            }
        }

        // Add the whole bundle to the real Shopify cart, then go to checkout
        document.getElementById('bundle-cta').addEventListener('click', async function () {
            const items = getBundle();
            if (items.length < DISCOUNT_AT) return; // not ready yet — button is disabled anyway

            const lineItems = items
                .filter(i => i.variantId)
                .map(i => ({ id: parseInt(i.variantId, 10), quantity: 1 }));

            if (lineItems.length !== items.length) {
                console.error('Bundle contains an item with no variant ID:', items);
                alert('Sorry, one of your bundle items could not be added to cart. Please remove it and try again.');
                return;
            }

            const cta = this;
            cta.disabled = true;
            cta.textContent = 'Adding to cart…';

            try {
                const res = await fetch('/cart/add.js', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ items: lineItems }),
                });
                if (!res.ok) throw new Error('Cart add failed with status ' + res.status);

                localStorage.removeItem(BUNDLE_KEY);
                window.location.href = '/cart';
            } catch (err) {
                console.error('Add to cart failed:', err);
                renderBundleBar();
                alert('Something went wrong adding your bundle to the cart. Please try again.');
            }
        });

        renderBundleBar();

        // If the user navigates Back to this page, the browser may restore it from
        // bfcache exactly as it was mid-request (button stuck on "Adding to cart…").
        // Re-render against the current (now-cleared) bundle state to reset it.
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) renderBundleBar();
        });

        // Badges must never wrap — instead, shrink font-size just enough for the
        // longest badge to fit on one line, and apply that same size to every
        // badge so they all stay visually uniform.
        function fitBadges() {
            const badges = document.querySelectorAll('.bundle-badge');
            if (!badges.length) return;

            const baseSize = parseFloat(getComputedStyle(badges[0]).fontSize);
            badges.forEach(b => { b.style.fontSize = baseSize + 'px'; });

            let minScale = 1;
            badges.forEach(b => {
                if (b.scrollWidth > b.clientWidth) {
                    minScale = Math.min(minScale, b.clientWidth / b.scrollWidth);
                }
            });

            if (minScale < 1) {
                const newSize = Math.floor(baseSize * minScale * 100) / 100;
                badges.forEach(b => { b.style.fontSize = newSize + 'px'; });
            }
        }

        window.addEventListener('load', fitBadges);
        let badgeResizeTimer;
        window.addEventListener('resize', function () {
            clearTimeout(badgeResizeTimer);
            badgeResizeTimer = setTimeout(fitBadges, 150);
        });
    })();
</script>

