
{% comment %} ── Google Fonts ── {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  /* ── Design tokens ── */
  #shopify-section-{{ section.id }} {
    --q-green:        #1F4C35;
    --q-green-hover:  #2d6b4a;
    --q-green-dark:   #142f21;
    --q-accent:       #B8875A;
    --q-accent-hover: #a3764c;
    --q-bg:           #F5F1E8;
    --q-bg-soft:      #EFEAE0;
    --q-border:       #e5e1d6;
    --q-muted:        #9a978c;
    --q-body:         #5c5a52;
    --q-selected-bg:  #eef3ec;
    --q-ink:          #26241f;
    --q-font-serif:   'Cormorant Garamond', serif;
    --q-font-sans:    'DM Sans', sans-serif;
    --q-radius-pill:  9999px;
    --q-radius-card:  1.5rem;
    --q-radius-sm:    0.85rem;
    --q-shadow-card:  0 30px 70px rgba(20,47,33,0.16), 0 6px 20px rgba(20,47,33,0.08);
    --q-shadow-img:   0 22px 50px rgba(31,76,53,0.20), 0 4px 14px rgba(0,0,0,0.08);
  }

  /* ── Reset / base ── */
  .quiz-page-wrap *, .euphoriel-overlay * { box-sizing: border-box; }
  .quiz-page-wrap { font-family: var(--q-font-sans); color: var(--q-ink); }

  /* ── Layout ── */
  .quiz-page-wrap {
    position: relative;
    display: flex;
    width: 100%;
    min-height: calc(100vh - var(--header-height, 80px));
    min-height: calc(100svh - var(--header-height, 80px));
    overflow: hidden;
  }

  .quiz-left-panel {
    position: relative;
    width: 44%;
    background: #ffffff;
    overflow: hidden;
    flex-shrink: 0;
  }
  .quiz-left-panel__glow {
    display: none;
  }
  .quiz-left-panel__grain {
    display: none;
  }
  .quiz-left-panel__stage {
    position: absolute; inset: 0;
  }

  .quiz-right-panel {
    position: relative;
    width: 56%;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: white;
  }
  .quiz-right-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 3rem clamp(2.5rem, 5vw, 5rem);
    max-width: 34rem;
  }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.22em;
    font-weight: 600; color: var(--q-green); margin-bottom: 1.1rem;
  }
  .eyebrow::before {
    content: ''; width: 22px; height: 1px; background: var(--q-green);
  }

  .hero-heading {
    font-family: var(--q-font-serif);
    text-transform: uppercase;
    font-weight: 600;
    font-size: clamp(2.85rem, 5.4vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--q-green);
    margin: 0 0 1.5rem;
  }
  .hero-heading em {
    font-style: italic;
    font-weight: 600;
    color: var(--q-green);
  }

  .hero-sub {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    font-weight: 500;
    color: var(--q-body);
    line-height: 1.7;
    max-width: 420px;
    margin: 0 0 2.5rem;
  }

  .hero-footnote {
    font-size: 0.75rem; color: var(--q-muted);
    text-transform: uppercase; letter-spacing: 0.14em; font-weight: 600;
    margin-top: 1.5rem;
    display: flex; align-items: center; gap: 0.6rem;
  }
  .hero-footnote .dot { color: var(--q-accent); }

  /* ── Floating product collage (desktop) ── */
  @keyframes floatIn {
    from { opacity: 0; transform: translateY(24px) rotate(var(--rot)); }
    to   { opacity: 1; transform: translateY(0)    rotate(var(--rot)); }
  }
  @keyframes drift {
    0%, 100% { transform: translateY(0)    rotate(var(--rot)); }
    50%       { transform: translateY(-8px) rotate(var(--rot)); }
  }
  .product-img {
    position: absolute;
    width: clamp(150px, var(--w), 210px);
    height: auto;
    aspect-ratio: 4 / 5;
    top: var(--t); left: var(--l); right: var(--r);
    border-radius: 1rem;
    object-fit: cover;
    box-shadow: var(--q-shadow-img);
    animation: floatIn 0.9s ease both, drift 6s ease-in-out infinite;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .product-img:hover { box-shadow: 0 34px 80px rgba(31,76,53,0.30), 0 8px 24px rgba(0,0,0,0.14); z-index: 20 !important; }
  .img-1 { --rot: -11deg; --w: 34%; --t: 10%; --l: 10%; z-index: 4; animation-delay: 0s,   0.9s; animation-duration: 0.9s, 7s; }
  .img-2 { --rot:   7deg; --w: 30%; --t: 8%;  --l: 48%; z-index: 3; animation-delay: 0.1s, 1.4s; animation-duration: 0.9s, 5.5s; }
  .img-4 { --rot:  12deg; --w: 29%; --t: 46%; --l: 50%; z-index: 5; animation-delay: 0.2s, 0.5s; animation-duration: 0.9s, 6.5s; }
  .img-6 { --rot:   6deg; --w: 35%; --t: 44%; --l: 8%;  z-index: 6; animation-delay: 0.3s, 1.8s; animation-duration: 0.9s, 7.5s; }

  /* ── Mobile hero strip (hidden on desktop) ── */
  .mobile-hero-strip {
    display: none;
  }

  /* ── Slide-up entrance ── */
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .slide-up { animation: slideUp 0.8s ease both; }
  .delay-1  { animation-delay: 0.15s; }
  .delay-2  { animation-delay: 0.3s; }
  .delay-3  { animation-delay: 0.45s; }
  .delay-4  { animation-delay: 0.6s; }

  /* ── Buttons ── */
  .eq-btn {
    position: relative;
    display: inline-flex; align-items: center; justify-content: center;
    overflow: hidden;
    font-family: var(--q-font-sans); font-weight: 600; font-size: 0.85rem;
    letter-spacing: 0.13em; text-transform: uppercase;
    border-radius: var(--q-radius-pill);
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease, border-color 0.25s ease, opacity 0.25s ease;
    border: 1.5px solid transparent;
    text-decoration: none;
    white-space: nowrap;
    appearance: none;
    -webkit-appearance: none;
    touch-action: manipulation;
  }
  .eq-btn--lg { padding: 20px 3.5rem; font-size: 0.95rem; letter-spacing: 0.15em; }
  .eq-btn--md { padding: 13px 2rem; }
  .eq-btn--primary { background: var(--q-green); color: white; }

  #startQuizBtn {
    font-size: 1rem;
    font-weight: 700;
    padding: 22px 3.75rem;
    letter-spacing: 0.16em;
    box-shadow: 0 12px 28px rgba(31,76,53,0.22);
  }

  .eq-btn--ghost { background: none; color: var(--q-green); border-color: var(--q-green); }

  .eq-btn--block { width: 100%; }

  .eq-icon-close {
    position: absolute; top: 1.15rem; right: 1.15rem;
    width: 34px; height: 34px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer;
    font-size: 1.35rem; line-height: 1; color: var(--q-muted);
  }
  .eq-icon-back { right: auto; left: 1.15rem; }
  .eq-icon-back[data-hidden="true"] { visibility: hidden; }

  /* ── Overlay base ── */
  .euphoriel-overlay {
    position: fixed; inset: 0; z-index: 9999;
    display: none !important;
    align-items: center; justify-content: center;
    padding: 1.5rem;
    pointer-events: none;
  }
  .euphoriel-overlay.is-open {
    display: flex !important;
    pointer-events: auto;
  }
  .overlay-scrim { position: absolute; inset: 0; z-index: 0; }

  .eq-modal-card {
    position: relative;
    z-index: 2;
    background: white;
    border-radius: var(--q-radius-card);
    box-shadow: var(--q-shadow-card);
    border: 1px solid rgba(31,76,53,0.08);
    width: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .eq-modal-card--quiz   { max-width: 500px; height: min(480px, 88svh); }
  .eq-modal-card--lead   { max-width: 460px; max-height: min(680px, 92svh); }
  .eq-modal-card--result { max-width: 560px; max-height: min(600px, 90svh); }

  .eq-modal-head {
    flex-shrink: 0;
    padding: 2.25rem 2.25rem 0;
  }
  .eq-modal-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 2.25rem 2.25rem;
  }
  .eq-modal-foot {
    flex-shrink: 0;
    padding: 0.85rem 2.25rem calc(0.85rem + env(safe-area-inset-bottom, 0px));
    display: flex; align-items: center; justify-content: flex-start;
    gap: 1rem;
    border-top: 1px solid var(--q-border);
    background: white;
  }
  /* Pull the divider closer to the Retake/Add To My Bundle buttons on the
     result screen specifically. */
  #resultOverlay .eq-modal-foot {
    padding-top: 0.3rem;
  }

  .eq-modal-eyebrow {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em;
    font-weight: 600; color: var(--q-green); margin: 1.25rem 0 0.6rem;
  }
  .eq-modal-question {
    font-family: var(--q-font-serif); font-weight: 600;
    font-size: 1.55rem; line-height: 1.25; color: var(--q-green);
    margin: 0 0 1.5rem;
  }

  /* ── Question-to-question transition ── */
  #questionWrap {
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  #questionWrap.is-fading {
    opacity: 0;
    transform: translateY(6px);
  }

  /* ── Completion success state ── */
  .eq-quiz-success {
    display: none;
    position: absolute; inset: 0;
    background: white;
    border-radius: inherit;
    align-items: center; justify-content: center;
    z-index: 5;
  }
  .eq-quiz-success.is-active { display: flex; }

  .eq-success-check {
    position: relative;
    width: 84px; height: 84px;
    border-radius: 50%;
    background: var(--q-green);
    opacity: 0;
    transform: scale(0.6);
  }
  .eq-quiz-success.is-active .eq-success-check {
    animation: successCircle 0.5s cubic-bezier(.34,1.56,.64,1) 0.15s forwards;
  }
  @keyframes successCircle {
    0%   { opacity: 0; transform: scale(0.6); }
    70%  { opacity: 1; transform: scale(1.06); }
    100% { opacity: 1; transform: scale(1); }
  }

  /* Checkmark: two solid bars that grow via scaleX — no border/width animation involved */
  .eq-tick-short, .eq-tick-long {
    position: absolute;
    overflow: hidden;
  }
  /* Geometry (84px circle, centre 42,42): short leg runs (24,42)→(36,54),
     long leg runs (36,54)→(60,30). The long bar starts 2px behind the elbow
     so the two strokes overlap and the joint reads as solid, not notched. */
  .eq-tick-short { left: 24px;   top: 39px;   width: 17px; height: 6px; transform: rotate(45deg);  transform-origin: left center; }
  .eq-tick-long  { left: 34.6px; top: 52.4px; width: 36px; height: 6px; transform: rotate(-45deg); transform-origin: left center; }

  .eq-tick-short__bar, .eq-tick-long__bar {
    position: absolute;
    inset: 0;
    background: white;
    transform: scaleX(0);
    transform-origin: left center;
  }
  /* Round only each bar's outer tip; the end at the joint stays square so no
     second rounded cap competes with the joint dot below. */
  .eq-tick-short__bar { border-radius: 3px 0 0 3px; }
  .eq-tick-long__bar  { border-radius: 0 3px 3px 0; }
  .eq-quiz-success.is-active .eq-tick-short__bar {
    animation: tickGrow 0.18s ease-out 0.35s forwards;
  }
  .eq-quiz-success.is-active .eq-tick-long__bar {
    animation: tickGrow 0.28s ease-out 0.5s forwards;
  }

  /* Small round plug exactly on the elbow (36,54) — the two pill-capped bars'
     rounded ends overlap into a lumpy blob without this; the dot unifies them
     into one clean rounded corner. */
  .eq-tick-joint {
    position: absolute;
    left: 33px; top: 51px;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: white;
    opacity: 0;
  }
  .eq-quiz-success.is-active .eq-tick-joint {
    animation: jointIn 0.1s linear 0.5s forwards;
  }
  @keyframes jointIn {
    to { opacity: 1; }
  }

  @keyframes tickGrow {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  /* ── Quiz option rows ── */
  .quiz-opt-list { position: relative; z-index: 1; }
  .quiz-opt {
    position: relative;
    z-index: 1;
    width: 100%; text-align: left;
    display: flex; align-items: center;
    padding: 18px 20px; margin-bottom: 14px;
    border-radius: var(--q-radius-sm);
    border: 1.5px solid var(--q-border); background: transparent; color: var(--q-ink);
    font-family: var(--q-font-sans); font-size: 0.92rem; font-weight: 500;
    cursor: pointer; pointer-events: auto;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .quiz-opt:last-child { margin-bottom: 0; }
  .quiz-opt.is-eq-selected {
    border-color: var(--q-green);
    color: var(--q-green);
    background: color-mix(in srgb, var(--q-green) 12%, transparent);
  }

  /* ── Lead form ── */
  .lead-copy-heading {
    font-family: var(--q-font-serif); font-weight: 600;
    font-size: clamp(1.9rem, 3vw, 2.35rem); color: var(--q-green);
    line-height: 1.1; margin: 0 0 0.6rem;
  }
  .lead-copy-sub {
    font-size: 0.9rem; color: var(--q-body); line-height: 1.6;
    margin: 0 0 1.1rem;
  }
  .lead-row { display: flex; gap: 12px; }
  .lead-input {
    font-family: var(--q-font-sans); font-size: 16px; color: var(--q-ink);
    background: white; padding: 14px 20px; border-radius: var(--q-radius-pill);
    border: 1.5px solid #d8d4c8; outline: none; width: 100%;
    transition: border-color 0.2s;
  }
  .lead-input:focus { border-color: var(--q-green); }
  .lead-consent {
    margin: 0; padding: 2px 4px 4px; text-align: left;
    font-size: 0.7rem; color: var(--q-muted); line-height: 1.6;
  }

  .lead-skip-link {
    background: none; border: none; padding: 4px;
    color: var(--q-muted); font-family: var(--q-font-sans);
    font-size: 0.78rem; font-weight: 500; text-decoration: underline;
    text-underline-offset: 2px; cursor: pointer; align-self: center;
  }
  .lead-skip-link:hover { color: var(--q-body); }

  /* ── Lead overlay decorative images ── */
  .lead-deco {
    position: absolute; pointer-events: none; z-index: 1;
    width: var(--w); height: auto; aspect-ratio: 4 / 5; object-fit: cover;
    top: var(--t); left: var(--l); right: var(--r); bottom: var(--b);
    border-radius: 1rem; box-shadow: var(--q-shadow-img);
    transform: rotate(var(--rot));
  }

  /* ── Result overlay ── */
  .result-label {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em;
    font-weight: 600; color: var(--q-green); margin: 1.75rem 0 1.1rem;
  }
  .result-row { display: flex; gap: 1.5rem; align-items: flex-start; margin-bottom: 0.5rem; }
  .result-img {
    height: 130px; width: auto; object-fit: contain; border-radius: 12px;
    box-shadow: var(--q-shadow-img); flex-shrink: 0; background: var(--q-bg);
  }
  .result-name { font-family: var(--q-font-serif); font-weight: 600; font-size: 1.6rem; color: var(--q-green); line-height: 1.2; margin: 0 0 0.35rem; }
  .result-price { display: flex; align-items: baseline; gap: 0.3rem; margin: 0 0 0.6rem; }
  .result-price-amount { font-size: 1.5rem; font-weight: 700; color: var(--q-green); line-height: 1; }
  .result-price-currency { font-size: 0.72rem; font-weight: 500; color: var(--q-body); text-transform: uppercase; letter-spacing: 0.06em; }
  .result-tagline { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--q-green); margin: 0 0 0.75rem; font-weight: 600; }
  .result-desc { font-size: 0.875rem; color: var(--q-body); line-height: 1.7; margin: 0; }
  .result-actions { display: flex; flex-wrap: nowrap; justify-content: flex-end; gap: 12px; margin-top: 1.5rem; width: 100%; }
  /* Explicitly lock width/display/flex here — the theme's own site-wide CSS may set
     `button, a { width: 100% }` or similar under a mobile breakpoint, and since .eq-btn
     never sets `width` at all, that theme rule would otherwise apply unopposed. */
  .result-actions .eq-btn {
    display: inline-flex !important;
    width: auto !important;
    flex: 0 1 auto !important;
  }

  /* ════════════════════════════════════════
     RESPONSIVE
  ════════════════════════════════════════ */

  @media (min-width: 1400px) {
    .quiz-left-panel { width: 46%; }
    .quiz-right-panel { width: 54%; }
  }

  @media (max-width: 1023px) and (min-width: 769px) {
    .quiz-right-inner { padding: 2.5rem; }
    .product-img { width: clamp(130px, var(--w), 180px); }
  }

  @media (max-width: 768px) {
    .quiz-page-wrap { flex-direction: column; min-height: auto; overflow: visible; }
    .quiz-left-panel { display: none; }
    .quiz-right-panel { width: 100%; }
    .quiz-right-inner {
      padding: 2.75rem 1.5rem 3.5rem;
      max-width: 100%;
      justify-content: flex-start;
    }

    .mobile-hero-strip {
      display: flex;
      justify-content: center;
      gap: 0.55rem;
      margin-bottom: 2rem;
    }
    .mobile-hero-strip img {
      width: 20vw; max-width: 88px; height: auto; aspect-ratio: 4 / 5;
      object-fit: cover; border-radius: 0.85rem;
      box-shadow: var(--q-shadow-img);
    }
    .mobile-hero-strip img:nth-child(2),
    .mobile-hero-strip img:nth-child(4) { transform: translateY(-10px); }

    .hero-heading { text-align: center; }
    .hero-sub { max-width: 100%; text-align: center; margin-left: auto; margin-right: auto; }
    .hero-footnote { justify-content: center; }
    .eyebrow { display: none; }

    .slide-up.center-cta { display: flex; justify-content: center; }
    .eq-btn--lg { width: 100%; max-width: 320px; }

    .euphoriel-overlay { padding: 0; align-items: flex-end; }
    .eq-modal-card { border-radius: 1.5rem 1.5rem 0 0; max-height: 92svh; }
    .eq-modal-card--quiz, .eq-modal-card--lead, .eq-modal-card--result { max-width: none; }
    .eq-modal-head { padding: 1.75rem 1.5rem 0; }
    .eq-modal-body { padding: 0 1.5rem; }
    .eq-modal-foot { padding: 1.1rem 1.5rem calc(1.4rem + env(safe-area-inset-bottom, 0px)); }

    .lead-row { flex-direction: column; }
    .result-row { flex-direction: column; align-items: center; text-align: center; }
    .result-price { justify-content: center; }
    .result-img { height: 150px; }
  }

  @media (max-width: 380px) {
    .quiz-right-inner { padding: 2.25rem 1.1rem 3rem; }
    .eq-modal-head { padding: 1.5rem 1.15rem 0; }
    .eq-modal-body { padding: 0 1.15rem; }
    .eq-modal-foot { padding: 1rem 1.15rem calc(1.25rem + env(safe-area-inset-bottom, 0px)); }
    .result-actions { gap: 8px; }
    .result-actions .eq-btn { padding-left: 1.25rem !important; padding-right: 1.25rem !important; font-size: 0.78rem !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .quiz-page-wrap *, .euphoriel-overlay * { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
  }
</style>

{% style %}
  #shopify-section-{{ section.id }} {
    margin: 0;
    padding: 0;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% comment %} ════════════════════════════════════════
  MAIN TWO-COLUMN LAYOUT
════════════════════════════════════════ {% endcomment %}
<div class="quiz-page-wrap section-{{ section.id }}-padding">

  {% comment %} ── LEFT PANEL: floating product collage (desktop/tablet) ── {% endcomment %}
  <div class="quiz-left-panel">
    <div class="quiz-left-panel__glow"></div>
    <div class="quiz-left-panel__grain"></div>
    <div class="quiz-left-panel__stage">
      <img src="https://cdn.shopify.com/s/files/1/0861/2062/8566/files/Copy_of_Balance_Elixir_Face_Oil-01.png?v=1746183125"
           width="800" height="1000" alt="Balance Elixir Face Oil" class="product-img img-1">
      <img src="https://cdn.shopify.com/s/files/1/0861/2062/8566/files/Copy_of_Harmonic_Elixir_Face_Oil-01.png?v=1746183215"
           width="800" height="1000" alt="Harmonic Elixir Face Oil" class="product-img img-2">
      <img src="https://cdn.shopify.com/s/files/1/0861/2062/8566/files/Copy_of_Timeless_Elixir_Face_Oil-01.png?v=1746183401"
           width="800" height="1000" alt="Timeless Elixir Face Oil" class="product-img img-4">
