{% comment %} ════════════════════════════════════════
  QUIZ JAVASCRIPT
════════════════════════════════════════ {% endcomment %}
<script>
(function() {

  // ── Quiz questions & scoring ──
  const questions = [
    {
      q: "How would you describe your skin type?",
      options: [
        { label: "Oily, shiny, or breakout-prone",                 scores: { balance: 3 } },
        { label: "Combination — oily in some areas, dry in others", scores: { harmonic: 3 } },
        { label: "Dry, tight, or dehydrated",                      scores: { renewal: 3 } },
        { label: "Mature, with fine lines or loss of firmness",    scores: { timeless: 3 } },
      ]
    },
    {
      q: "What's your biggest skin concern right now?",
      options: [
        { label: "Clogged pores, blackheads, or breakouts",       scores: { balance: 3 } },
        { label: "Uneven texture or dullness",                    scores: { harmonic: 2, renewal: 1 } },
        { label: "Fine lines or loss of firmness",                scores: { timeless: 3 } },
        { label: "Redness, tightness, or stripped-feeling skin",  scores: { renewal: 3 } },
      ]
    },
    {
      q: "Right after cleansing, how does your skin feel?",
      options: [
        { label: "Oily again within an hour",                     scores: { balance: 3 } },
        { label: "Tight in some spots, oily in others",           scores: { harmonic: 3 } },
        { label: "Comfortable, just needs more moisture",         scores: { renewal: 3 } },
        { label: "Tight, dry, or irritated",                      scores: { renewal: 3 } },
      ]
    },
    {
      q: "What's the #1 result you want from your skincare routine?",
      options: [
        { label: "Clearer skin and less shine",                   scores: { balance: 3 } },
        { label: "Balance — calm oily zones, hydrate dry zones",  scores: { harmonic: 3 } },
        { label: "Firmer, smoother, more youthful-looking skin",  scores: { timeless: 3 } },
        { label: "Calm, soothe, and protect sensitive skin",      scores: { renewal: 3 } },
      ]
    },
  ];

  // ── Product data ──
  const products = {
    balance: {
      name:    "Balance Elixir",
      tagline: "Oily and blemish-prone skin",
      desc:    "Regulates oil, clears pores, and calms your skin without drying it out. Lightweight and fast-absorbing with jojoba, tamanu, and sea buckthorn.",
      price:   "$39.99 CAD",
      img:     "https://cdn.shopify.com/s/files/1/0861/2062/8566/files/Copy_of_Balance_Elixir_Face_Oil-01.png?v=1746183125",
      handle:  "balance-elixir-face-oil",
    },
    harmonic: {
      name:    "Harmonic Elixir",
      tagline: "Combination skin",
      desc:    "Hydrates where you need it, regulates where you don't. Works on both the oily zones and dry patches at the same time without clogging pores.",
      price:   "$39.99 CAD",
      img:     "https://cdn.shopify.com/s/files/1/0861/2062/8566/files/Copy_of_Harmonic_Elixir_Face_Oil-01.png?v=1746183215",
      handle:  "harmonic-elixir-face-oil",
    },
    renewal: {
      name:    "Renewal Elixir",
      tagline: "Normal to dry skin",
      desc:    "Deep hydration without feeling heavy. Rosehip, marula, and vitamin C replenish moisture, even skin tone, and bring back the glow.",
      price:   "$39.99 CAD",
      img:     "https://cdn.shopify.com/s/files/1/0861/2062/8566/files/Copy_of_Renewal_Elixir_Face_Oil-01.png?v=1746183141",
      handle:  "renewal-elixir-face-oil",
    },
    timeless: {
      name:    "Timeless Elixir",
      tagline: "Mature and aging skin",
      desc:    "Firms, smooths, and nourishes skin that has lost some elasticity. Coenzyme Q10, camellia, and vitamin C visibly soften fine lines over time.",
      price:   "$39.99 CAD",
      img:     "https://cdn.shopify.com/s/files/1/0861/2062/8566/files/Copy_of_Timeless_Elixir_Face_Oil-01.png?v=1746183401",
      handle:  "timeless-elixir-face-oil",
    },
  };

  // ── State ──
  let step = 0;
  let answers = [];
  let matchedKey = null;

  // ── DOM refs ──
  const quizOverlay   = document.getElementById('quizOverlay');
  const leadOverlay   = document.getElementById('leadOverlay');
  const resultOverlay = document.getElementById('resultOverlay');
  const questionWrap  = document.getElementById('questionWrap');
  const quizSuccess   = document.getElementById('quizSuccess');
  const prevBtn       = document.getElementById('prevBtn');

  // ── Overlay helpers ──
  // Safari (iOS) rubber-bands / zooms the page behind a fixed overlay unless the
  // body itself is locked in place — toggling position:fixed with the saved
  // scroll offset is the standard fix.
  let lockedScrollY = 0;
  let openOverlayCount = 0;
  function lockBodyScroll() {
    if (openOverlayCount === 0) {
      lockedScrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${lockedScrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
    }
    openOverlayCount++;
  }
  function unlockBodyScroll() {
    openOverlayCount = Math.max(0, openOverlayCount - 1);
    if (openOverlayCount === 0) {
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      window.scrollTo(0, lockedScrollY);
    }
  }
  function showOverlay(el)  { el.classList.add('is-open'); lockBodyScroll(); }
  function hideOverlay(el)  { if (el.classList.contains('is-open')) { el.classList.remove('is-open'); unlockBodyScroll(); } }
  function hideAll()        { [quizOverlay, leadOverlay, resultOverlay].forEach(hideOverlay); }

  // ── Render question ──
  function renderQuestion() {
    const q     = questions[step];
    const saved = answers[step];
    prevBtn.dataset.hidden  = step === 0 ? 'true' : 'false';

    questionWrap.innerHTML = `
      <p class="eq-modal-eyebrow">Question ${step + 1} of ${questions.length}</p>
      <h2 class="eq-modal-question">${q.q}</h2>
      <div class="quiz-opt-list">
        ${q.options.map((o, i) => `
          <button type="button" class="quiz-opt${saved && saved.idx === i ? ' is-eq-selected' : ''}" data-idx="${i}">
            <span>${o.label}</span>
          </button>
        `).join('')}
      </div>
    `;
  }

  // Event delegation — survives re-renders and avoids CSP/inline-handler issues
  questionWrap.addEventListener('click', function(e) {
    const btn = e.target.closest('.quiz-opt');
    if (!btn || !questionWrap.contains(btn)) return;
    e.preventDefault();
    selectOption(parseInt(btn.dataset.idx, 10));
  });

  // ── Select option ──
  function selectOption(idx) {
    answers[step] = { scores: questions[step].options[idx].scores, idx };
    questionWrap.querySelectorAll('.quiz-opt').forEach((b, i) => {
      b.classList.toggle('is-eq-selected', i === idx);
    });

    setTimeout(() => {
      if (step < questions.length - 1) {
        goToNextQuestion();
      } else {
        showCompletion();
      }
    }, 350);
  }

  // ── Fade out current question, render next, fade back in ──
  function goToNextQuestion() {
    questionWrap.classList.add('is-fading');
    setTimeout(() => {
      step++;
      renderQuestion();
      void questionWrap.offsetWidth; // force reflow so the fade-in transition runs
      questionWrap.classList.remove('is-fading');
    }, 220);
  }

  // ── Completion sequence: fade question out, pause, draw success check, then continue ──
  function showCompletion() {
    questionWrap.classList.add('is-fading');
    setTimeout(() => {
      quizSuccess.classList.add('is-active');
      const parts = [
        quizSuccess.querySelector('.eq-success-check'),
        quizSuccess.querySelector('.eq-tick-short__bar'),
        quizSuccess.querySelector('.eq-tick-long__bar'),
      ];

      // Wait for ALL THREE animations to genuinely finish (whichever runs longest),
      // so tweaking any one duration can never cut the others off mid-play.
      let finished = 0;
      function onAnimDone(e) {
        if (!parts.includes(e.target)) return;
        finished++;
        if (finished < parts.length) return;
        parts.forEach(p => p.removeEventListener('animationend', onAnimDone));
        // Brief pause so the finished checkmark is actually seen before advancing
        setTimeout(() => {
          computeMatch();
          hideOverlay(quizOverlay);
          showOverlay(leadOverlay);
          questionWrap.classList.remove('is-fading');
          quizSuccess.classList.remove('is-active');
        }, 450);
      }
      parts.forEach(p => p.addEventListener('animationend', onAnimDone));
    }, 220);
  }

  // ── Compute result ──
  function computeMatch() {
    const totals = { balance: 0, harmonic: 0, renewal: 0, timeless: 0 };
    answers.forEach(a => {
      if (!a) return;
      Object.entries(a.scores).forEach(([k, v]) => { if (k in totals) totals[k] += v; });
    });
    matchedKey = Object.entries(totals).sort((a, b) => b[1] - a[1])[0][0];
  }

  // ── Render result ──
  function renderResult() {
    const p = products[matchedKey];
    document.getElementById('resultImg').src             = p.img;
    document.getElementById('resultName').textContent    = p.name;
    document.getElementById('resultTagline').textContent = p.tagline;
    document.getElementById('resultDesc').textContent    = p.desc;

    // Split "$39.99 CAD" into a bold amount + a smaller, lighter currency label
    const [, amount, currency] = p.price.match(/^(\S+)\s*(.*)$/);
    const priceEl = document.getElementById('resultPrice');
    priceEl.replaceChildren();
    const amountSpan = document.createElement('span');
    amountSpan.className = 'result-price-amount';
    amountSpan.textContent = amount;
    priceEl.appendChild(amountSpan);
    if (currency) {
      const currencySpan = document.createElement('span');
      currencySpan.className = 'result-price-currency';
      currencySpan.textContent = currency;
      priceEl.appendChild(currencySpan);
    }

    // Set bundle button URL with face param
    const bundleBtn = document.getElementById('bundleBtn');
    bundleBtn.href = '/pages/about?view=build-your-bundle&face=' + matchedKey;

    hideAll();
    showOverlay(resultOverlay);
  }

  // ── Klaviyo lead submission ──
  async function submitToKlaviyo(first, last, email) {
    const KLAVIYO_PUBLIC_KEY = 'WVZPTu';
    const KLAVIYO_LIST_ID    = 'YswWdg';

    const payload = {
      data: {
        type: 'subscription',
        attributes: {
          profile: {
            data: {
              type: 'profile',
              attributes: {
                first_name:  first,
                last_name:   last,
                email:       email,
                properties: {
                  skin_quiz_result: matchedKey,
                }
              }
            }
          },
          custom_source: 'Skin Quiz',
        },
        relationships: {
          list: { data: { type: 'list', id: KLAVIYO_LIST_ID } }
        }
      }
    };

    try {
      const res = await fetch(`https://a.klaviyo.com/client/subscriptions/?company_id=${KLAVIYO_PUBLIC_KEY}`, {
        method:  'POST',
        headers: { 'content-type': 'application/vnd.api+json', 'revision': '2026-10-15' },
        body:    JSON.stringify(payload),
      });
      if (!res.ok) {
        console.warn('Klaviyo rejected the subscription:', res.status, await res.text());
      }
    } catch (err) {
      console.warn('Klaviyo submission failed:', err);
      // Non-blocking — still show result even if Klaviyo fails
    }
  }

  // Note: the matched product is intentionally NOT added to the bundle here.
  // bundle-page.liquid reads the `?face=` param on its own arrival and adds the
  // correct product (with a real variant ID) via its own button's dataset —
  // adding it here too caused the same item to be added twice under mismatched
  // names, and this copy never had a variantId the real cart-add flow needs.

  // ── Event listeners ──
  document.getElementById('startQuizBtn').addEventListener('click', function() {
    step = 0; answers = [];
    showOverlay(quizOverlay);
    renderQuestion();
  });

  prevBtn.addEventListener('click', function() {
    if (step > 0) { step--; renderQuestion(); }
  });

  document.getElementById('closeQuiz').addEventListener('click', function() {
    hideOverlay(quizOverlay);
  });

  document.getElementById('closeResult').addEventListener('click', function() {
    hideOverlay(resultOverlay);
  });

  document.getElementById('retakeBtn').addEventListener('click', function() {
    step = 0; answers = [];
    hideAll();
    showOverlay(quizOverlay);
    renderQuestion();
  });

  document.getElementById('skipLeadBtn').addEventListener('click', renderResult);

  document.getElementById('leadForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const first = document.getElementById('leadFirst').value.trim();
    const last  = document.getElementById('leadLast').value.trim();
    const email = document.getElementById('leadEmail').value.trim();
    await submitToKlaviyo(first, last, email);
    renderResult();
  });

})();
</script>

