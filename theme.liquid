  <!-- Cart Size Toggle - works in cart drawer and cart page -->
  <script>
  (function() {
    const VARIANTS = {
      {%- assign toggle_products = 'radiance-ritual-shower-oil,rejuvenating-shea-body-butter,revitalizing-mango-body-butter,golden-aura-body-oil,balance-elixir-face-oil,timeless-elixir-face-oil,renewal-elixir-face-oil,harmonic-elixir-face-oil' | split: ',' -%}
      {%- for handle in toggle_products -%}
        {%- assign p = all_products[handle] -%}
        {%- if p -%}
          {%- assign full_v = p.variants[0] -%}
          {%- assign travel_v = p.variants[1] -%}
          {%- for v in p.variants -%}
            {%- assign t = v.title | downcase -%}
            {%- if t contains 'travel' or t contains 'mini' -%}
              {%- assign travel_v = v -%}
            {%- else -%}
              {%- assign full_v = v -%}
            {%- endif -%}
          {%- endfor -%}
          "{{ handle }}": {
            title: {{ p.title | json }},
            full: { id: {{ full_v.id }}, price: {{ full_v.price }} },
            travel: { id: {{ travel_v.id }}, price: {{ travel_v.price }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endif -%}
      {%- endfor %}
    };

    const PRODUCT_IMAGES = {
      'renewal-elixir-face-oil': {
        full: 'https://cdn.shopify.com/s/files/1/0861/2062/8566/files/Copy_of_Renewal_Elixir_Face_Oil-01.png?v=1746183141',
        travel: 'https://res.cloudinary.com/dyhflagbc/image/upload/v1787329244/Copy_of_Renewal_Elixir_Face_Oil-02.png_rivung.webp'
      },
      'timeless-elixir-face-oil': {
        full: 'https://cdn.shopify.com/s/files/1/0861/2062/8566/files/Copy_of_Timeless_Elixir_Face_Oil-01.png?v=1746183401',
        travel: 'https://res.cloudinary.com/dyhflagbc/image/upload/v1787329435/Copy_of_Timeless_Elixir_Face_Oil-02.png_wmabwx.webp'
      },
      'harmonic-elixir-face-oil': {
        full: 'https://cdn.shopify.com/s/files/1/0861/2062/8566/files/Copy_of_Harmonic_Elixir_Face_Oil-01.png?v=1746183215',
        travel: 'https://res.cloudinary.com/dyhflagbc/image/upload/v1787329501/Copy_of_Harmonic_Elixir_Face_Oil-02.png_fn8vis.webp'
      },
      'balance-elixir-face-oil': {
        full: 'https://cdn.shopify.com/s/files/1/0861/2062/8566/files/Copy_of_Balance_Elixir_Face_Oil-01.png?v=1746183125',
        travel: 'https://res.cloudinary.com/dyhflagbc/image/upload/v1787329557/Copy_of_Balance_Elixir_Face_Oil-02.png-2_m8pbw6.webp'
      }
    };

    const style = document.createElement('style');
    style.textContent = `
      .cart-size-toggle { display: flex !important; gap: 8px; margin: 10px 0; }
      .cart-size-toggle-btn { font-family: 'DM Sans', -apple-system, sans-serif; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; padding: 6px 8px; border-radius: 9999px; border: 1px solid #1F4C35 !important; cursor: pointer !important; transition: background-color 0.15s ease, color 0.15s ease; white-space: nowrap; -webkit-appearance: none; line-height: 1; }
      .cart-size-toggle-btn.active { background-color: #1F4C35 !important; color: white !important; }
      .cart-size-toggle-btn:not(.active) { background-color: white !important; color: #1F4C35 !important; }
      .cart-size-toggle-btn:disabled { opacity: 0.6; cursor: pointer !important; }
      .cart-size-toggle-btn.loading { color: transparent !important; position: relative; cursor: pointer !important; }
      .cart-size-toggle-btn.loading::after { content: ''; position: absolute; width: 14px; height: 14px; top: 50%; left: 50%; margin: -7px 0 0 -7px; border: 2px solid #1F4C35; border-right-color: transparent; border-radius: 50%; animation: cartSpin 0.5s linear infinite; }
      .cart-size-toggle-btn.active.loading::after { border-color: white; border-right-color: transparent; }
      @keyframes cartSpin { to { transform: rotate(360deg); } }
      [data-size-toggle-processed] [class*="variant"], [data-size-toggle-processed] [class*="option"]:not(.cart-size-toggle):not(.cart-size-toggle-btn), [data-size-toggle-processed] .cart__item__option { display: none !important; }
      [data-cart-items-total] { text-decoration: line-through; opacity: 0.6; }
    `;
    document.head.appendChild(style);

    const formatMoney = (cents) => '$' + (cents / 100).toFixed(2);

    function init() {
      document.querySelectorAll('.cart__item, .cart-item, [data-cart-item]').forEach(el => {
        if (el.dataset.sizeToggleProcessed) return;
        if (el.closest('[data-size-toggle-processed]')) return;
        
        let handle = null, variantData = null;
        const link = el.querySelector('a[href*="/products/"]');
        if (link) {
          for (const [h, data] of Object.entries(VARIANTS)) {
            if (link.href.includes(h)) { handle = h; variantData = data; break; }
          }
        }
        if (!handle) {
          for (const [h, data] of Object.entries(VARIANTS)) {
            if (el.textContent.includes(data.title)) { handle = h; variantData = data; break; }
          }
        }
        if (!handle || !variantData) return;

        el.dataset.sizeToggleProcessed = 'true';
        const text = el.textContent.toLowerCase();
        const isFullSize = !text.includes('travel') || text.includes('full');

        const toggle = document.createElement('div');
        toggle.className = 'cart-size-toggle';
        const fullBtn = document.createElement('button');
        fullBtn.type = 'button';
        fullBtn.className = 'cart-size-toggle-btn' + (isFullSize ? ' active' : '');
        fullBtn.textContent = 'Full Size';
        const travelBtn = document.createElement('button');
        travelBtn.type = 'button';
        travelBtn.className = 'cart-size-toggle-btn' + (!isFullSize ? ' active' : '');
        travelBtn.textContent = 'Travel Size';

        async function switchTo(variant, btn, otherBtn) {
          if (btn.classList.contains('active') || btn.disabled) return;
          fullBtn.disabled = true; travelBtn.disabled = true;
          btn.classList.add('loading');
          try {
            const cart = await (await fetch('/cart.js')).json();
            const item = cart.items.find(i => i.handle === handle);
            if (item) {
              await fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: item.key, quantity: 0 }) });
              await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: variant.id, quantity: item.quantity }] }) });
              
              // Update button states
              btn.classList.remove('loading');
              btn.classList.add('active');
              otherBtn.classList.remove('active');
              
              // Swap image for face oils
              const images = PRODUCT_IMAGES[handle];
              if (images) {
                const imgEl = el.querySelector('img');
                if (imgEl) {
                  imgEl.src = (btn === travelBtn) ? images.travel : images.full;
                  imgEl.srcset = '';
                }
              }
              
              // Update line item price (unit price * quantity)
              const priceEls = el.querySelectorAll('[class*="price"], .money');
              priceEls.forEach(p => {
                if (p.textContent.includes('$') && !p.closest('.cart__total')) {
                  p.textContent = formatMoney(variant.price * item.quantity);
                }
              });
              
              // Fetch updated cart totals
              const newCart = await (await fetch('/cart.js')).json();
              
              // Update ITEMS subtotal (with strikethrough)
              const itemsTotal = document.querySelector('[data-cart-items-total]');
              if (itemsTotal) itemsTotal.textContent = formatMoney(newCart.original_total_price);
              
              // Update discount amount (in cart__discounts)
              document.querySelectorAll('.cart__discounts .cart__total span:last-child').forEach(e => {
                const discount = newCart.original_total_price - newCart.total_price;
                e.textContent = '-' + formatMoney(discount);
              });
              
              // Update final subtotal (struck-out and actual)
              const totalMoney = document.querySelector('.cart__total__money[data-cart-total-price]');
              if (totalMoney) {
                const strike = totalMoney.querySelector('.cart__total__strike');
                if (strike) strike.textContent = formatMoney(newCart.original_total_price);
                // Update the text node (actual subtotal) - replace only the price portion
                totalMoney.childNodes.forEach(node => {
                  if (node.nodeType === 3 && node.textContent.includes('$')) {
                    node.textContent = node.textContent.replace(/\$[\d,.]+/, formatMoney(newCart.total_price));
                  }
                });
              }
              
              // Update checkout button - preserve bullet separator if present
              document.querySelectorAll('.cart__checkout, button[name="checkout"]').forEach(e => {
                const text = e.textContent;
                if (text.includes('$')) {
                  // Replace just the price, preserving everything else (bullet, spacing, currency code)
                  e.textContent = text.replace(/\$[\d,.]+/, formatMoney(newCart.total_price));
                }
              });
            }
          } catch (e) { console.error('Switch error:', e); btn.classList.remove('loading'); }
          fullBtn.disabled = false; travelBtn.disabled = false;
        }

        fullBtn.onclick = () => switchTo(variantData.full, fullBtn, travelBtn);
        travelBtn.onclick = () => switchTo(variantData.travel, travelBtn, fullBtn);
        toggle.appendChild(fullBtn); toggle.appendChild(travelBtn);
        
        if (el.querySelector('.cart-size-toggle')) return;
        const title = el.querySelector('.cart__item__title, .cart-item__title, [class*="item__title"], h2 a, h3 a');
        if (title?.parentNode) title.parentNode.insertBefore(toggle, title.nextSibling);
        else el.appendChild(toggle);
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => setTimeout(init, 100));
    else setTimeout(init, 100);
    new MutationObserver(() => setTimeout(init, 150)).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class', 'aria-hidden', 'data-visible'] });
    ['cart:open', 'cart:updated', 'cart:refresh', 'drawer:open'].forEach(e => document.addEventListener(e, () => setTimeout(init, 200)));
    document.addEventListener('click', (e) => { if (e.target.closest('[data-cart-toggle], [data-drawer-toggle], .cart-icon, .cart-link, [href*="cart"]')) { setTimeout(init, 300); setTimeout(init, 600); } });
  })();
  </script>

</body>
</html>
